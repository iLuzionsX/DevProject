From: RenoDX AMD bridge experiment
Subject: [PATCH 1/2] dlss: expose Streamline DLSS input to alternate backend

Target: clshortfuse/renodx@8d360960a8bdeccada1a1babf7f02215c15c82e8

This patch is intentionally fail-open. If no alternate backend is registered,
all calls continue through the existing Streamline path. Feature support is
only overridden when a backend has explicitly registered an evaluation
callback.

---
 src/utils/dlss/amd_bridge.hpp    | new file (copy from renodx-amd/src/amd_bridge.hpp)
 src/utils/dlss/streamline_v2.hpp | integration changes described below

The integration changes are:
- capture Streamline resources after RenoDX clone redirection
- capture Streamline common temporal constants
- offer DLSS evaluation to an alternate backend before NVIDIA Streamline
- report DLSS supported/loaded only while that backend is registered
- otherwise preserve the original RenoDX/Streamline behavior

diff --git a/src/utils/dlss/streamline_v2.hpp b/src/utils/dlss/streamline_v2.hpp
index 17109dd..EXPERIMENT 100644
--- a/src/utils/dlss/streamline_v2.hpp
+++ b/src/utils/dlss/streamline_v2.hpp
@@
 #include "../platform.hpp"
 #include "../resource.hpp"
+#include "./amd_bridge.hpp"
 #include "./DXGIFactoryWrapper.hpp"
 #include "./DXGISwapChainWrapper.hpp"
@@
+static decltype(&slIsFeatureSupported) Real_slIsFeatureSupported = nullptr;
+static sl::Result Hooked_slIsFeatureSupported(sl::Feature feature, const sl::AdapterInfo& adapterInfo) {
+  if (feature == sl::kFeatureDLSS && renodx::utils::dlss::amd_bridge::IsBackendAvailable()) {
+    return sl::Result::eOk;
+  }
+  return Real_slIsFeatureSupported(feature, adapterInfo);
+}
+
+static decltype(&slIsFeatureLoaded) Real_slIsFeatureLoaded = nullptr;
+static sl::Result Hooked_slIsFeatureLoaded(sl::Feature feature, bool& loaded) {
+  if (feature == sl::kFeatureDLSS && renodx::utils::dlss::amd_bridge::IsBackendAvailable()) {
+    loaded = true;
+    return sl::Result::eOk;
+  }
+  return Real_slIsFeatureLoaded(feature, loaded);
+}
+
+static decltype(&slSetConstants) Real_slSetConstants = nullptr;
+static sl::Result Hooked_slSetConstants(const sl::Constants& values, const sl::FrameToken& frame, const sl::ViewportHandle& viewport) {
+  if (renodx::utils::dlss::amd_bridge::IsBackendAvailable()) {
+    renodx::utils::dlss::amd_bridge::CaptureConstants(values);
+  }
+  return Real_slSetConstants(values, frame, viewport);
+}
+
 static decltype(&slEvaluateFeature) Real_slEvaluateFeature = nullptr;
 SL_API sl::Result Hooked_slEvaluateFeature(sl::Feature feature, const sl::FrameToken& frame, const sl::BaseStructure** inputs, uint32_t numInputs, sl::CommandBuffer* cmdBuffer) {
   (void)frame;
   const bool unwrapped = utils::directx::NativeFromReShadeProxy(&cmdBuffer);
   assert((unwrapped || cmdBuffer == nullptr) && "slEvaluateFeature expected a ReShade proxy command buffer.");
+
+  sl::Result alternate_result = sl::Result::eOk;
+  if (renodx::utils::dlss::amd_bridge::TryEvaluate(
+          feature,
+          frame,
+          inputs,
+          numInputs,
+          cmdBuffer,
+          &alternate_result)) {
+    return alternate_result;
+  }
+
   return Real_slEvaluateFeature(feature, frame, inputs, numInputs, cmdBuffer);
 }
@@
